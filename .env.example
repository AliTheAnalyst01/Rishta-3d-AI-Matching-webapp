# Environment Configuration
# Copy this to .env and fill in values

# ── PostgreSQL ────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/rishta_db

# ── Google Sheets ─────────────────────────────────────────────────
# Base64-encoded GCP service account JSON (no newlines)
GOOGLE_SHEETS_CREDENTIALS_B64=

# ── Claude (Anthropic) ─────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-...

# ── Frontend URL (for CORS) ───────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Auth / Runtime ─────────────────────────────────────────────────
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
APP_ENV=production

# ── Docker compose prod variables ──────────────────────────────────
POSTGRES_USER=rishta_user
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=rishta_db
NEXT_PUBLIC_API_URL=https://your-domain.example/api
